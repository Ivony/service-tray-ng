<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>service_tray_ng</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Edition Condition="'$(Edition)' == ''">all</Edition>
    <AssemblyName Condition="'$(Edition)' == 'all'">service-tray-ng</AssemblyName>
    <AssemblyName Condition="'$(Edition)' != 'all'">service-tray-ng-$(Edition)</AssemblyName>
    <Version>0.2.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Edition)' == 'dsh'">
    <DefineConstants>$(DefineConstants);EDITION_DSH</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Edition)' == 'opencode'">
    <DefineConstants>$(DefineConstants);EDITION_OPENCODE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\opencode-logo-light.png" />
    <EmbeddedResource Include="Assets\opencode-logo-dark.png" />
    <EmbeddedResource Include="Assets\dsh-logo-light.png" />
    <EmbeddedResource Include="Assets\dsh-logo-dark.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="service-tray-ng.Tests" />
  </ItemGroup>

</Project>
